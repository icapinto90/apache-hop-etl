  <transform>
    <name>recompute_sls_price</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>recompute</jsScript_name>
        <jsScript_script>var sls_price_new;
if (sls_price == null || sls_price &lt;= 0) {
  sls_price_new = (sls_quantity == 0) ? null : sls_sales / sls_quantity;
} else {
  sls_price_new = sls_price;
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sls_price_new</name>
        <rename>sls_price</rename>
        <type>Number</type>
        <length>-1</length>
        <precision>2</precision>
        <replace>Y</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>912</xloc>
      <yloc>560</yloc>
    </GUI>
  </transform>
  <transform>
    <name>recompute_sls_sales</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>recompute</jsScript_name>
        <jsScript_script>var sls_sales_new;
var expected = sls_quantity * Math.abs(sls_price);
if (sls_sales == null || sls_sales &lt;= 0 || sls_sales != expected) {
  sls_sales_new = expected;
} else {
  sls_sales_new = sls_sales;
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sls_sales_new</name>
        <rename>sls_sales</rename>
        <type>Number</type>
        <length>-1</length>
        <precision>2</precision>
        <replace>Y</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>752</xloc>
      <yloc>560</yloc>
    </GUI>
